rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'region', 'severity',
          'createdAt', 'active', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.region is string
        && request.resource.data.severity in ['info', 'warning', 'alert', 'all_clear']
        && request.resource.data.active is bool
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /regional_status/{regionId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'region', 'status', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.region is string
        && request.resource.data.status in ['unknown', 'safe', 'alert']
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
